{
  pkgs,
  vencordSrc,
}:

let
  lib = pkgs.lib;

  # Read the PNPM hash generated by Github Actions
  pnpmHash = lib.fileContents ./vencord-pnpm-hash.txt;

  # Discord source manifest (version + distro + per-module brotli archives),
  # refreshed by scripts/sync-discord-deps.py from the distributions API.
  source = lib.importJSON (
    if pkgs.stdenv.hostPlatform.isDarwin then ./sources-darwin.json else ./sources.json
  );

  # Pin pnpm 11 (package.json packageManager)
  # pnpm 12 breaks fetchPnpmDeps' jq fixup on darwin (nixpkgs PR #565315)
  vencordPnpm = pkgs.pnpm_11;

  vencord-git = pkgs.vencord.overrideAttrs (
    finalAttrs: _prev: {
      pname = "vencord-git";
      version = vencordSrc.version;
      src = vencordSrc.src;
      patches = [ ];
      postPatch = "";

      pnpmDeps = pkgs.fetchPnpmDeps {
        inherit (finalAttrs)
          pname
          src
          patches
          postPatch
          ;
        pnpm = vencordPnpm;
        fetcherVersion = 4;
        hash = pnpmHash;
      };

      nativeBuildInputs = map (dep: if lib.getName dep == "pnpm" then vencordPnpm else dep) (
        _prev.nativeBuildInputs or [ ]
      );

      env = {
        VENCORD_REMOTE = "Vendicated/Vencord";
        VENCORD_HASH = vencordSrc.version;
      };

      passthru = { };
    }
  );

  # nixpkgs moved discord to by-name and reads `source` from metadata.nix
  sourceOverride =
    if (lib.functionArgs pkgs.discord.override) ? source then
      { inherit source; }
    else
      {
        callPackage =
          fn: args:
          let
            result = pkgs.callPackage fn args;
          in
          if baseNameOf (toString fn) == "metadata.nix" then
            result
            // {
              discord = result.discord // {
                inherit source;
              };
            }
          else
            result;
      };

  # Discord >= 1.0.167 rejects native modules that resolve outside its modules dir, so
  # nixpkgs' store symlinks render a blank client. Stage real copies instead, re-copied
  # only when the store path changes (the modules are ~350 MB).
  stageLink = ''ln -sn "$store_modules/$m" "$modules_dir/$m"'';
  stageReset = ''rm -rf "$modules_dir"'';
  stageStamp = ''"$(dirname "$modules_dir")/nix-store-modules"'';
  copyModules =
    text:
    assert lib.assertMsg (lib.hasInfix stageLink text && lib.hasInfix stageReset text)
      "discord: nixpkgs stageModules changed shape; update the copy patch in pkgs/discord";
    lib.replaceStrings
      [ stageReset stageLink ]
      [
        ''
          [ "$(cat ${stageStamp} 2>/dev/null)" = "$store_modules" ] && [ -d "$modules_dir" ] && exit 0
          chmod -R u+w "$modules_dir" 2>/dev/null
          ${stageReset}''
        ''cp -R "$store_modules/$m" "$modules_dir/$m" && chmod -R u+w "$modules_dir/$m"''
      ]
      text
    + ''
      echo "$store_modules" > ${stageStamp}
    '';

  writeShellScript =
    name: text:
    pkgs.writeShellScript name (if name == "discord-stage-modules" then copyModules text else text);

  discord-stable = pkgs.discord.override (
    sourceOverride
    // {
      inherit writeShellScript;
      withVencord = true;
      vencord = vencord-git;
    }
  );

  # Fail loudly if the injection stops applying (e.g. nixpkgs renames metadata.nix)
  discord-checked =
    assert lib.assertMsg (discord-stable.version == source.version)
      "discord: source override not applied (nixpkgs ${discord-stable.version}, manifest ${source.version})";
    discord-stable;

in
{
  discord = discord-checked;
  vencord = vencord-git;
}
