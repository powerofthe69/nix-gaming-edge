{
  pkgs,
  vencordSrc,
}:

let
  lib = pkgs.lib;

  # Read the PNPM hash generated by Github Actions
  pnpmHash = lib.fileContents ./vencord-pnpm-hash.txt;

  # Discord source manifest (version + distro + per-module brotli archives),
  # refreshed by scripts/sync-discord-deps.py from the distributions API.
  source = lib.importJSON (
    if pkgs.stdenv.hostPlatform.isDarwin then ./sources-darwin.json else ./sources.json
  );

  # Pin pnpm 11 (package.json packageManager)
  # pnpm 12 breaks fetchPnpmDeps' jq fixup on darwin (nixpkgs PR #565315)
  vencordPnpm = pkgs.pnpm_11;

  vencord-git = pkgs.vencord.overrideAttrs (
    finalAttrs: _prev: {
      pname = "vencord-git";
      version = vencordSrc.version;
      src = vencordSrc.src;
      patches = [ ];
      postPatch = "";

      pnpmDeps = pkgs.fetchPnpmDeps {
        inherit (finalAttrs)
          pname
          src
          patches
          postPatch
          ;
        pnpm = vencordPnpm;
        fetcherVersion = 4;
        hash = pnpmHash;
      };

      nativeBuildInputs = map (dep: if lib.getName dep == "pnpm" then vencordPnpm else dep) (
        _prev.nativeBuildInputs or [ ]
      );

      env = {
        VENCORD_REMOTE = "Vendicated/Vencord";
        VENCORD_HASH = vencordSrc.version;
      };

      passthru = { };
    }
  );

  # nixpkgs moved discord to by-name and reads `source` from metadata.nix
  sourceOverride =
    if (lib.functionArgs pkgs.discord.override) ? source then
      { inherit source; }
    else
      {
        callPackage =
          fn: args:
          let
            result = pkgs.callPackage fn args;
          in
          if baseNameOf (toString fn) == "metadata.nix" then
            result
            // {
              discord = result.discord // {
                inherit source;
              };
            }
          else
            result;
      };

  discordArgs = sourceOverride // {
    withVencord = true;
    vencord = vencord-git;
  };

  discord-base = pkgs.discord.override discordArgs;

  # Workaround the legacy updater for Discord until upstream nixpkgs ships a fix
  modulesShim = ''
    const path = require("path");
    const configBase = process.env.DISCORD_USER_DATA_DIR ?? (process.env.XDG_CONFIG_HOME || path.join(require("os").homedir(), ".config"));
    require("module").globalPaths.push(path.join(configBase, "discord", "${source.version}", "modules"));
  '';

  unwrapped-patched = discord-base.passthru.unwrappedDiscord.overrideAttrs (old: {
    postInstall = (old.postInstall or "") + ''
      res=$out/opt/Discord/resources
      [ -f $res/app.asar/index.js ] || { echo "discord: modules shim needs a mod entrypoint (withVencord)"; exit 1; }
      printf '%s\n' ${lib.escapeShellArg modulesShim} | cat - $res/app.asar/index.js > index.js.new
      mv index.js.new $res/app.asar/index.js
      # Keep the native updater from starting against the read-only store install
      ${lib.getExe pkgs.jq} '.disableUpdater = true' $res/build_info.json > build_info.json.new
      mv build_info.json.new $res/build_info.json
    '';
  });

  discord-stable =
    if pkgs.stdenv.hostPlatform.isLinux then
      pkgs.discord.override (discordArgs // { unwrappedDiscord = unwrapped-patched; })
    else
      discord-base;

  # Fail loudly if the injection stops applying (e.g. nixpkgs renames metadata.nix)
  discord-checked =
    assert lib.assertMsg (discord-stable.version == source.version)
      "discord: source override not applied (nixpkgs ${discord-stable.version}, manifest ${source.version})";
    discord-stable;

in
{
  discord = discord-checked;
  vencord = vencord-git;
}
